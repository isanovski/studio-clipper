# ── warna (mengikuti tema Ink/Ember, dimatikan kalau bukan TTY) ──────────────
TTY = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
def w(kode: str, teks: str) -> str:
    return f"\033[{kode}m{teks}\033[0m" if TTY else teks

AMBER = lambda t: w("38;5;214", t)
DIM = lambda t: w("2", t)
TEBAL = lambda t: w("1", t)
MERAH = lambda t: w("31", t)
HIJAU = lambda t: w("32", t)
GARIS = lambda t: w("38;5;240", t)


def lebar() -> int:
    try:
        return max(60, min(88, shutil.get_terminal_size((84, 24)).columns))
    except OSError:
        return 84


def garis(kar="─") -> None:
    print(GARIS(kar * min(lebar(), 76)))


def judul(teks: str) -> None:
    print()
    print(TEBAL(AMBER("  " + teks)))
    garis()


def info(teks: str) -> None:
    print(DIM("  " + teks))


def ok(teks: str) -> None:
    print("  " + HIJAU("✓ ") + teks)


def gagal(teks: str) -> None:
    print("  " + MERAH("✗ ") + teks)


def tanya(label: str, bawaan: str = "") -> str:
    """Tanya satu baris; Enter = nilai bawaan."""
    ekor = f" {DIM('[' + bawaan + ']')}" if bawaan else ""
    try:
        jawab = input(f"  {label}{ekor}: ").strip()
    except EOFError:
        return bawaan
    return jawab or bawaan


def pilih(label: str, opsi: list[str], bawaan: int = 0) -> int:
    """Menu bernomor. Enter = pilihan bawaan (1-based di layar)."""
    for i, o in enumerate(opsi, 1):
        tanda = AMBER("›") if i - 1 == bawaan else " "
        print(f"  {tanda} {DIM(str(i))} {o}")
    print()
    while True:
        jawab = tanya(label, str(bawaan + 1))
        if jawab.isdigit() and 1 <= int(jawab) <= len(opsi):
            return int(jawab) - 1
        gagal("Pilih angka yang ada di daftar.")


def ya(label: str, bawaan: bool = True) -> bool:
    jawab = tanya(label + (" [Y/n]" if bawaan else " [y/N]")).lower()
    if not jawab:
        return bawaan
    return jawab.startswith("y")


def manusia(byte: int) -> str:
    for satuan in ("B", "KB", "MB", "GB"):
        if byte < 1024 or satuan == "GB":
            return f"{byte:.0f} {satuan}" if satuan == "B" else f"{byte:.1f} {satuan}"
        byte /= 1024
    return f"{byte:.1f} GB"


def detik_ke_teks(d: int) -> str:
    j, s = divmod(int(d), 3600)
    m, s = divmod(s, 60)
    return f"{j} jam {m} menit" if j else (f"{m} menit" if m else f"{s} detik")


def bungkus(teks: str, lebar_maks: int) -> list[str]:
    kata, baris, kini = teks.split(), [], ""
    for k in kata:
        if len(kini) + len(k) + 1 > max(20, lebar_maks):
            baris.append(kini)
            kini = k
        else:
            kini = (kini + " " + k).strip()
    if kini:
        baris.append(kini)
    return baris or [""]


def bersihkan_jalur(teks: str) -> str:
    """Tempelan drag & drop biasanya berbungkus kutip atau di-escape."""
    t = teks.strip().strip("'\"").replace("\\ ", " ").replace("file://", "")
    return os.path.expanduser(t)


def durasi_video(path: str | Path) -> float | None:
    """Durasi video dalam detik via ffprobe. None jika gagal."""
    try:
        import subprocess as sp
        r = sp.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", str(path)],
            capture_output=True, text=True, timeout=30,
        )
        if r.returncode != 0 or not r.stdout.strip():
            return None
        return float(r.stdout.strip())
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


# ── menjalankan proses dengan status hidup ───────────────────────────────────
class Status:
    """Status satu baris, TANPA spinner/background.

    Spinner berbasis thread menulis \r ke stdout dan bercampur dengan baris
    output child → layar jadi berantakan dan baris input_user tampak misplaced.
    Sekarang: cetak satu baris status, laluibiarkan child mencetak sendiri.
    """

    def __init__(self, label: str):
        self.label = label

    def __enter__(self):
        print(f"  {AMBER('›')} {self.label}…")
        return self

    def henti(self) -> None:
        pass

    def __exit__(self, *_):
        self.henti()


def jalan(cmd: list[str], cwd: Path | None = None, label: str = "bekerja", kering: bool = False) -> int:
    """Jalankan perintah, tampilkan keluarannya sebagai langkah-langkah."""
    if kering:
        info("(uji kering) " + " ".join(cmd))
        return 0
    env = os.environ.copy()
    env.setdefault("PYTHONUNBUFFERED", "1")
    kunci = baca_kunci()
    if kunci and not env.get("GEMINI_API_KEY"):
        env["GEMINI_API_KEY"] = kunci      # kunci dari .env/pengaturan ikut ke proses anak
    print()
    proses = subprocess.Popen(cmd, cwd=str(cwd or AKAR), env=env, text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=1)

    # Ctrl+C (SIGINT) / SIGTERM harus sampai ke child, dan pesannya harus jelas.
    def teruskan(sig, _frame):
        try:
            proses.send_signal(sig)
        except (ProcessLookupError, OSError):
            pass
    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            signal.signal(sig, teruskan)
        except (ValueError, OSError):
            pass

    with Status(label):
        try:
            assert proses.stdout is not None
            for baris in proses.stdout:
                baris = baris.rstrip()
                if not baris:
                    continue
                if baris.startswith("•"):
                    print("  " + AMBER("│") + " " + baris.lstrip("• ").strip())
                else:
                    print("  " + DIM(baris[:lebar() - 4]))
        except KeyboardInterrupt:
            print()
            info("Diblatalkan (Ctrl+C).")
            with suppress(ProcessLookupError, OSError):
                proses.terminate()
            proses.wait(timeout=30)
            print()
            gagal("dibatalkan")
            return 130
        kode = proses.wait()
    print()
    if kode == 0:
        ok("selesai")
    elif kode in (130, 143, -2, -15):
        info("Proses dihentikan sistem (Ctrl+C / SIGTERM).")
        gagal(f"dibatalkan (kode {kode})")
        return 130
    else:
        gagal(f"gagal (kode {kode})")
    return kode


