    if not nama:
        nama = topik[:30].replace(" ", "_")

    tujuan = HASIL / f"{nama}-{datetime.now():%Y%m%d-%H%M}"
    n = 2
    while tujuan.exists():
        tujuan = HASIL / f"{nama}-{datetime.now():%Y%m%d-%H%M}-{n}"
        n += 1

    print()
    info(f"hasil akan disimpan di {tujuan.relative_to(AKAR)}")
