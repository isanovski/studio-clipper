            print()
            ok(f"video: {hasil.relative_to(AKAR)} ({manusia(hasil.stat().st_size)})")


# ── alur 3: kunci AI ────────────────────────────────────────────────────────
def alur_kunci() -> None:
    judul("Kunci AI (Gemini)")
    kunci, asal = sumber_kunci()
    if kunci:
        ok("terbaca dari " + asal + " (" + kunci[:6] + "…" + kunci[-4:] + ")")
        if asal != "klip/.env":
            info("sudah dipakai otomatis; menempel di sini akan menyalinnya ke klip/.env")
    else:
        info("belum ada — tanpa kunci, pemilih momen memakai heuristik lokal.")
    print()
    info("Ambil kunci gratis di https://aistudio.google.com/apikey")
    info("Tempel di sini (tidak akan terlihat di layar). Enter = batal.")
    print()
    try:
        import getpass
        baru = getpass.getpass("  Kunci: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if bukan := baru.strip().strip('"').strip("'"):
        baru = bukan
    if baru.startswith("GEMINI_API_KEY="):
        baru = baru.split("=", 1)[1].strip().strip('"').strip("'")
    if not baru:
        return
    if not kunci_valid(baru):
        gagal(f"Kunci tidak valid ({len(baru)} karakter, {len(baru.split())} kata).")
        info("Tempel hanya nilainya, mis. AQ.Ab8… atau AIza… — tanpa spasi dan tanpa 'GEMINI_API_KEY='.")
        return
    simpan_kunci(baru)
    ok(f"disimpan di {KUNCI_ENV.relative_to(AKAR)} (hanya bisa dibaca kamu)")
    print()
    kode = jalan([uv_cmd(), "run", "klip/klip.py", "--uji-ai", "gemini"], label="menguji kunci")
    if kode != 0:
        info("Kunci tersimpan tapi uji gagal — cek kuota/jaringan, atau ganti kuncinya.")


