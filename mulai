def alur_kunci() -> None:
    judul("Kunci AI (Gemini / OpenRouter)")
    kunci, asal = sumber_kunci()
    if kunci:
        ok("terbaca dari " + asal + " (" + kunci[:6] + "... " + kunci[-4:] + ")")
        if asal != "klip/.env":
            info("sudah dipakai otomatis; menempel di sini akan menyalinnya ke klip/.env")
    else:
        info("belum ada — tanpa kunci, pemilih momen memakai heuristik lokal.")
    print()
    print("  1. Gemini (Google AI Studio)")
    print("  2. OpenRouter (model gratis)")
    pil = tanya("Pilih [1]:", "1").strip()
    nama_env = "GEMINI_API_KEY" if pil != "2" else "OPENROUTER_API_KEY"
    link = "https://aistudio.google.com/apikey" if pil != "2" else "https://openrouter.ai/keys"
    contoh = "AIza…" if pil != "2" else "sk-or-v1…"
    print()
    info(f"Ambil kunci gratis di {link}")
    info("Tempel di sini (tidak akan terlihat di layar). Enter = batal.")
    print()
    try:
        import getpass
        baru = getpass.getpass("  Kunci: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if bukan := baru.strip().strip('"').strip("'"):
        baru = bukan
    if baru.startswith(nama_env + "="):
        baru = baru.split("=", 1)[1].strip().strip('"').strip("'")
    if not baru:
        return
    if not kunci_valid(baru):
        gagal(f"Kunci tidak valid ({len(baru)} karakter, {len(baru.split())} kata).")
        info(f"Tempel hanya nilainya, mis. {contoh} — tanpa spasi dan tanpa '{nama_env}= '.")
        return
    simpan_kunci(nama_env, baru)
    ok(f"disimpan di {KUNCI_ENV.relative_to(AKAR)} (hanya bisa dibaca kamu)")
    print()
    kode = jalan([uv_cmd(), "run", "klip/klip.py", "--uji-ai", "openrouter" if pil == "2" else "gemini"], label="menguji kunci")
    if kode != 0:
        info("Kunci tersimpan tapi uji gagal — cek kuota/jaringan, atau ganti kuncinya.")


