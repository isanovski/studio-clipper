def ada(cmd: str) -> bool:
    return shutil.which(cmd) is not None or (AKAR / cmd).exists()


def cek_uv() -> bool:
    for kandidat in (["uv"], [str(Path.home() / ".local/bin/uv")]):
        try:
            r = subprocess.run(kandidat + ["--version"], capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                return True
        except (OSError, subprocess.SubprocessError):
            continue
    return False


def uv_cmd() -> str:
    return shutil.which("uv") or str(Path.home() / ".local/bin/uv")


PENGATURAN = Path(os.environ.get("STUDIO_DATA") or (Path.home() / "Studio Maliki")) / "pengaturan.env"


def _dari_berkas(f: Path, nama: str) -> str:
    if not f.exists():
        return ""
    try:
        isi = f.read_text(encoding="utf-8")
    except OSError:
        return ""
    for baris in isi.splitlines():
        b = baris.strip()
        if b.startswith(nama + "="):
            return b.split("=", 1)[1].strip().strip('"').strip("'")
    return ""


def sumber_kunci() -> tuple[str, str]:
    """Cari GEMINI_API_KEY: environment → klip/.env → pengaturan web UI.

    Kunci dari web UI (Pengaturan AI) tersimpan di ~/Studio Maliki/pengaturan.env,
    jadi tidak perlu mengisi ulang di terminal.
    """
    v = (os.environ.get("GEMINI_API_KEY") or "").strip()
    if v:
        return v, "environment"
    for f, label in ((KUNCI_ENV, "klip/.env"), (PENGATURAN, "pengaturan web UI")):
        v = _dari_berkas(f, "GEMINI_API_KEY")
        if v:
            return v, label
    return "", ""


def baca_kunci() -> str:
    return sumber_kunci()[0]


def kunci_valid(kunci: str) -> bool:
    """Kunci Gemini baru berformat `AQ.…`; jangan menolak titik/garis."""
    return len(kunci) >= 20 and not re.search(r"\s", kunci) and all(33 <= ord(c) < 127 for c in kunci)


def simpan_kunci(kunci: str) -> None:
    isi = KUNCI_ENV.read_text(encoding="utf-8") if KUNCI_ENV.exists() else ""
    if re.search(r"^GEMINI_API_KEY=.*$", isi, re.M):
        isi = re.sub(r"^GEMINI_API_KEY=.*$", f"GEMINI_API_KEY={kunci}", isi, count=1, flags=re.M)
    else:
        isi = (isi.rstrip() + f"\nGEMINI_API_KEY={kunci}\n") if isi else f"GEMINI_API_KEY={kunci}\n"
    KUNCI_ENV.parent.mkdir(parents=True, exist_ok=True)
    KUNCI_ENV.write_text(isi, encoding="utf-8")
    try:
        os.chmod(KUNCI_ENV, 0o600)
    except OSError:
        pass


VIDEO_EKST = {".mp4", ".mov", ".mkv", ".webm", ".m4v", ".avi", ".ts", ".flv"}
LEWATI = {".git", "node_modules", "__pycache__", "hasil", "out", ".kerja", "dist", ".cache"}


def cari_video(batas: int = 12) -> list[Path]:
    """Kumpulkan berkas video di sekitar repo + folder unggahan web UI."""
    akar_cari = [Path.cwd(), AKAR, AKAR / "unggahan", PENGATURAN.parent / "unggahan"]
    ketemu: dict[Path, float] = {}
    for awal in akar_cari:
        if not awal.exists():
            continue
        for f in awal.rglob("*"):
            if len(f.parts) - len(awal.parts) > 3:
                continue
            if any(b in LEWATI or b.startswith("hasil-") for b in f.parts[len(awal.parts):-1]):
                continue
            if f.is_file() and f.suffix.lower() in VIDEO_EKST:
                try:
                    ketemu.setdefault(f.resolve(), f.stat().st_mtime)
                except OSError:
                    continue
    urut = sorted(ketemu.items(), key=lambda x: -x[1])
    return [f for f, _ in urut][:batas]


def durasi_video(jalur: str) -> int:
    """Durasi dalam detik lewat ffprobe kalau ada; 0 kalau tidak tahu."""
    if not shutil.which("ffprobe") or jalur.startswith("http"):
        return 0
    try:
        r = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                            "-of", "default=nw=1:nk=1", jalur],
                           capture_output=True, text=True, timeout=20)
        return int(float(r.stdout.strip())) if r.returncode == 0 and r.stdout.strip() else 0
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0


# ── alur 1: klip ─────────────────────────────────────────────────────────────
def alur_klip(kering: bool = False) -> None:
    judul("Potong video jadi klip 9:16")
    daftar = cari_video()
    sumber = ""
    if daftar:
        info("Video yang ketemu (urut dari yang terbaru):")
        print()
        opsi = []
        for v in daftar:
            try:
                ukuran = manusia(v.stat().st_size)
            except OSError:
                ukuran = "?"
            try:
                nama = v.relative_to(AKAR)
            except ValueError:
                nama = v
            teks = str(nama)
            if len(teks) > 44:
                teks = "…" + teks[-43:]
            print(f"    {DIM(str(len(opsi) + 1))} {teks:<45} {DIM(ukuran)}")
            opsi.append(v)
        print(f"    {DIM(str(len(opsi) + 1))} tempel jalur lain / link YouTube")
        print(f"    {DIM(str(len(opsi) + 2))} batal")
        print()
        while True:
            jawab = tanya("Pilih video", "1")
            if jawab.isdigit() and 1 <= int(jawab) <= len(opsi) + 2:
                ke = int(jawab) - 1
                break
            gagal(f"Pilih 1–{len(opsi) + 2}.")
        if ke < len(opsi):
            sumber = str(opsi[ke])
        elif ke == len(opsi) + 1:
            return
        else:
            info("Seret file ke sini, atau tempel link YouTube, lalu Enter.")
            sumber = bersihkan_jalur(tanya("Jalur / link"))
    else:
        info("Belum ada file video di sekitar sini.")
        info("Seret file videonya ke terminal (atau tempel jalur / link YouTube).")
        print()
        sumber = bersihkan_jalur(tanya("Jalur / link"))
    if not sumber:
        return

    if sumber.startswith("http"):
        info("Link diterima — pengunduhan bisa gagal kalau IP ini diblokir YouTube.")
    else:
        p = Path(sumber)
        if not p.exists() and not p.is_absolute():
            p = (Path.cwd() / sumber)
        if not p.exists():
            gagal(f"File tidak ditemukan: {sumber}")
            return
        sumber = str(p.resolve())
        d = durasi_video(sumber)
        if d:
            panjang = detik_ke_teks(d)
            rendah, tinggi = d * 2.5 / 60, d * 5 / 60
            if tinggi < 1:
                kira = "kurang dari 1 menit"
            else:
                kira = f"{max(1, int(rendah))}–{max(2, int(tinggi))} menit"
            ok(f"{p.name} · {panjang} · perkiraan transkripsi {kira}")

    print()
    jumlah = tanya("Jumlah klip", "3")
    durasi = tanya("Durasi tiap klip (detik)", "30")
    print()
    ai_ke = pilih("Pemilih momen", ["lokal (gratis, tanpa kunci)", "gemini (butuh kunci)"], 0)
    ai = "lokal" if ai_ke == 0 else "gemini"
    if ai == "gemini" and not baca_kunci():
        gagal("Kunci Gemini belum ada. Pilih menu 3 dulu, atau lanjut dengan lokal.")
        if not ya("Lanjut pakai lokal?", True):
            return
        ai = "lokal"
    print()
    arahan = tanya("Cari momen tertentu? (kosong = bebas)", "")

    if sumber.startswith("http"):
        slug = "youtube"
    else:
        slug = re.sub(r"[^a-z0-9]+", "-", Path(sumber).stem.lower()).strip("-")[:30] or "klip"
    tujuan = HASIL / f"{slug}-{datetime.now():%Y%m%d-%H%M}"
    n = 2
    while tujuan.exists():          # jangan menimpa hasil di menit yang sama
        tujuan = HASIL / f"{slug}-{datetime.now():%Y%m%d-%H%M}-{n}"
        n += 1
    print()
    info(f"hasil akan disimpan di {tujuan.relative_to(AKAR)}")
    if not ya("Mulai sekarang?", True):
        return

    cmd = [uv_cmd(), "run", "klip/klip.py", sumber,
           "--jumlah", str(jumlah), "--durasi", str(durasi),
           "--keluar", str(tujuan), "--ai", ai]
    if arahan:
        cmd += ["--arahan", arahan]
    kode = jalan(cmd, label="menganalisis & merender", kering=kering)
    if kode != 0:
        print()
        info("Kalau videonya dari YouTube, unduh dulu di laptop lalu seret filenya.")
        return
    hasil_klip(tujuan, kering=kering)


def hasil_klip(tujuan: Path, kering: bool = False) -> None:
    if kering:
        info("(uji kering) tidak ada berkas yang dibuat")
        return
    berkas = sorted(tujuan.glob("klip-*.mp4"))
    judul("Selesai")
    if not berkas:
        gagal("Tidak ada klip yang dihasilkan.")
        return
    total = sum(b.stat().st_size for b in berkas)
    ok(f"{len(berkas)} klip · total {manusia(total)} · {tujuan.relative_to(AKAR)}")
    for b in berkas:
        print(f"    {AMBER(b.name)}  {DIM(manusia(b.stat().st_size))}")

    # judul & hook dari klip.json
    data = []
    kj = tujuan / "klip.json"
    if kj.exists():
        try:
            data = json.loads(kj.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            data = []

    print()
    while True:
        aksi = pilih("Lanjut apa?", [
            "sudah cukup, kembali ke menu",
            "lihat judul & hook tiap klip",
            "render ulang klip tertentu",
            "cara mengambil file ini",
        ], 0)
        if aksi == 0:
            return
        if aksi == 1:
            if not data:
                info("klip.json tidak ada / kosong.")
                continue
            for i, d in enumerate(data, 1):
                print()
                print("  " + TEBAL(f"{i}. {d.get('judul') or '(tanpa judul)'}"))
                skor = d.get("skor")
                hook = d.get("hook")
                ekor = []
                if skor is not None:
                    ekor.append(f"skor {skor}")
                if isinstance(hook, (int, float)):
                    ekor.append(f"hook {hook}")
                elif hook:
                    ekor.append(str(hook))
                if d.get("mulai") is not None:
                    ekor.append(f"{d['mulai']}–{d.get('selesai')} detik")
                if ekor:
                    print("     " + DIM(" · ".join(ekor)))
                for label, isi in (("alasan", d.get("alasan")), ("kutipan", d.get("kutipan"))):
                    if not isi:
                        continue
                    baris = bungkus(str(isi), lebar() - 20)
                    print("     " + DIM(f"{label}: ") + baris[0])
                    for lanjut in baris[1:]:
                        print("     " + " " * (len(label) + 2) + lanjut)
            print()
        elif aksi == 2:
            nomor = tanya("Nomor klip yang dirender ulang (mis. 1,3)")
            if not nomor:
                continue
            jalan([uv_cmd(), "run", "klip/klip.py", "--keluar", str(tujuan),
                   "--render", "--pilih", nomor], label="merender ulang")
        elif aksi == 3:
            cara_ambil(tujuan)


