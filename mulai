def ada(cmd: str) -> bool:
    return shutil.which(cmd) is not None or (AKAR / cmd).exists()


def cek_uv() -> bool:
    """uv terpasang? (PATH sering tidak memuat ~/.hermes/bin → cek jalur mutlak)"""
    for kandidat in (["uv"], [str(Path.home() / ".hermes/bin/uv")], [str(Path.home() / ".local/bin/uv")],
                     [str(Path.home() / ".cargo/bin/uv")], ["/usr/local/bin/uv"]):
        try:
            r = subprocess.run(kandidat + ["--version"], capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                return True
        except (OSError, subprocess.SubprocessError):
            continue
    return False


def uv_cmd() -> str:
    """Cari uv. PATH shell sering tidak memuat ~/.hermes/bin → cari juga di jalur mutlak."""
    hasil = shutil.which("uv")
    if hasil:
        return hasil
    for calon in (Path.home() / ".hermes/bin/uv", Path.home() / ".local/bin/uv",
                  Path.home() / ".cargo/bin/uv", Path("/usr/local/bin/uv")):
        if calon.exists():
            return str(calon)
    return "uv"


PENGATURAN = Path(os.environ.get("STUDIO_DATA") or (Path.home() / "Studio Maliki")) / "pengaturan.env"


def _dari_berkas(f: Path, nama: str) -> str:
    if not f.exists():
        return ""
    try:
        isi = f.read_text(encoding="utf-8")
    except OSError:
        return ""
    for baris in isi.splitlines():
        b = baris.strip()
        if b.startswith(nama + "="):
            return b.split("=", 1)[1].strip().strip('"').strip("'")
    return ""


def sumber_kunci() -> tuple[str, str]:
    """Cari GEMINI_API_KEY: environment → klip/.env → pengaturan web UI.

    Kunci dari web UI (Pengaturan AI) tersimpan di ~/Studio Maliki/pengaturan.env,
    jadi tidak perlu mengisi ulang di terminal.
    """
    v = (os.environ.get("GEMINI_API_KEY") or "").strip()
    if v:
        return v, "environment"
    for f, label in ((KUNCI_ENV, "klip/.env"), (PENGATURAN, "pengaturan web UI")):
        v = _dari_berkas(f, "GEMINI_API_KEY")
        if v:
            return v, label
    return "", ""


def ada_openrouter() -> bool:
    """True kalau ada kunci OpenRouter (dipakai untuk AI produksi gratis)."""
    for f in (KUNCI_ENV, Path.home() / "Studio Maliki" / "pengaturan.env"):
        if f.exists():
            for baris in f.read_text(encoding="utf-8", errors="replace").splitlines():
                if baris.strip().startswith("OPENROUTER_API_KEY=") and baris.split("=", 1)[1].strip():
                    return True
    return bool(os.environ.get("OPENROUTER_API_KEY"))


def baca_kunci() -> str:
    return sumber_kunci()[0]


def kunci_valid(kunci: str) -> bool:
    """Kunci baru berformat `AQ.…` atau `sk-or-v1…`; jangan menolak titik/garis."""
    return len(kunci) >= 20 and not re.search(r"\s", kunci) and all(33 <= ord(c) < 127 for c in kunci)


def simpan_kunci(nama: str, kunci: str) -> None:
    """Simpan kunci ke klip/.env (chmod 600)."""
    isi = KUNCI_ENV.read_text(encoding="utf-8") if KUNCI_ENV.exists() else ""
    if re.search(rf"^{nama}=.*$", isi, re.M):
        isi = re.sub(rf"^{nama}=.*$", f"{nama}={kunci}", isi, count=1, flags=re.M)
    else:
        isi = (isi.rstrip() + f"\n{nama}={kunci}\n") if isi else f"{nama}={kunci}\n"
    KUNCI_ENV.parent.mkdir(parents=True, exist_ok=True)
    KUNCI_ENV.write_text(isi, encoding="utf-8")
    try:
        os.chmod(KUNCI_ENV, 0o600)
    except OSError:
        pass

