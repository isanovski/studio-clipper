#!/usr/bin/env python3
import os
import sys
from pathlib import Path

KLIP_PY = Path(__file__).resolve().parent / "klip.py"

sumber = input("Video (file atau link YouTube): ").strip()
if not sumber:
    print("Wajib diisi.")
    sys.exit(1)

cmd = [
    sys.executable, str(KLIP_PY), sumber,
    "--keluar", "hasil-klip",
    "--jumlah", "3",
    "--durasi", "30",
    "--layout", "gamer",
    "--ai", "lokal",
    "--model", "small",
    "--momen", "umum",
    "--render",
]
print("Menjalankan:", " ".join(cmd))
os.execv(sys.executable, cmd)
